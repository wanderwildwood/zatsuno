    <!-- Knots -->

    <!-- %1$s is the step number -->
    <string name="knot_step">Step %1$s</string>

    <string name="knot_overhand">Overhand knot</string>
    <string name="knot_overhand_use">A stopper at the end of a rope, and the start of many other knots.</string>
    <string name="knot_overhand_1">Make a loop, the end crossing over the standing part.</string>
    <string name="knot_overhand_2">Bring the end round behind and up through the loop. Pull both ends tight.</string>

    <string name="knot_figure_eight">Figure-eight knot</string>
    <string name="knot_figure_eight_use">A bigger stopper than the overhand, and easier to untie.</string>
    <string name="knot_figure_eight_1">Make a loop, the end crossing over the standing part.</string>
    <string name="knot_figure_eight_2">Take the end round behind the standing part.</string>
    <string name="knot_figure_eight_3">Pass it down through the loop from the front. Pull tight; it should look like an 8.</string>

    <string name="knot_figure_eight_loop">Figure-eight loop</string>
    <string name="knot_figure_eight_loop_use">A strong fixed loop that won\'t slip, at the end of a rope or in the middle.</string>
    <string name="knot_figure_eight_loop_1">Fold the rope to make a long bight.</string>
    <string name="knot_figure_eight_loop_2">Tie a figure-eight with the doubled rope, leaving the fold as the loop. Keep the strands side by side and pull tight.</string>

    <string name="knot_bowline">Bowline</string>
    <string name="knot_bowline_use">A fixed loop at the end of a rope that holds under load and unties easily after.</string>
    <string name="knot_bowline_1">Make a small loop in the standing part, the side toward the end lying on top. Leave enough rope for the big loop.</string>
    <string name="knot_bowline_2">Bring the end up through the small loop and round behind the standing part.</string>
    <string name="knot_bowline_3">Take it back down through the small loop, beside itself. Hold the end and the loop side together and pull the standing part.</string>

    <string name="knot_clove_hitch">Clove hitch</string>
    <string name="knot_clove_hitch_use">Ties a rope to a post or rail quickly, and is easy to adjust. It can work loose if the pull keeps changing.</string>
    <string name="knot_clove_hitch_1">Wrap the end round the post.</string>
    <string name="knot_clove_hitch_2">Cross it over itself and wrap round again.</string>
    <string name="knot_clove_hitch_3">Tuck the end under that last crossing. Pull both ends.</string>

    <string name="knot_two_half_hitches">Two half hitches</string>
    <string name="knot_two_half_hitches_use">Ties a rope to a ring, post or tree, and holds under a steady pull.</string>
    <string name="knot_two_half_hitches_1">Take the end round the post and back beside the standing part.</string>
    <string name="knot_two_half_hitches_2">Pass it over the standing part, round behind it, and out under itself. That is one half hitch.</string>
    <string name="knot_two_half_hitches_3">Make a second the same way, a little further along. Slide them snug.</string>

    <string name="knot_taut_line">Taut-line hitch</string>
    <string name="knot_taut_line_use">An adjustable loop for tent and tarp guylines: slide it to tighten, and it holds.</string>
    <string name="knot_taut_line_1">Take the end round the stake and back beside the line.</string>
    <string name="knot_taut_line_2">Wrap it twice round the line, working back toward the stake, inside the loop.</string>
    <string name="knot_taut_line_3">Bring it out across the wraps and make one more turn round the line outside them, tucked under itself. Slide the knot to tighten.</string>

    <string name="knot_sheet_bend">Sheet bend</string>
    <string name="knot_sheet_bend_use">Joins two ropes, even of different thickness.</string>
    <string name="knot_sheet_bend_1">Fold a bight in the thicker rope.</string>
    <string name="knot_sheet_bend_2">Bring the other end up through the bight and round behind both of its legs.</string>
    <string name="knot_sheet_bend_3">Cross it over the bight and tuck it under its own standing part. Pull tight.</string>

    <string name="knot_square_knot">Square knot</string>
    <string name="knot_square_knot_use">Ties the two ends of one cord round something, like a bandage or a bundle. Not for joining ropes that will take a load.</string>
    <string name="knot_square_knot_1">Right over left: cross the ends and tuck one under.</string>
    <string name="knot_square_knot_2">Left over right: cross them the other way and tuck again. Each end comes out beside its own part.</string>
    <string name="knot_square_knot_3">Pull both pairs of ends tight.</string>

    <string name="knot_prusik">Prusik</string>
    <string name="knot_prusik_use">A loop of thinner cord that grips a rope when loaded and slides when not: for a sliding anchor or hauling.</string>
    <string name="knot_prusik_1">Lay the cord loop behind the rope and pass one end of it round the rope and through the other end.</string>
    <string name="knot_prusik_2">Do it twice more, three wraps in all, inside the first. Dress the wraps flat and side by side, and load it to test the grip.</string>

    <string name="knot_double_fishermans">Double fisherman\'s knot</string>
    <string name="knot_double_fishermans_use">Joins two ropes securely, or makes a loop of cord for a prusik. Hard to untie after a load.</string>
    <string name="knot_double_fishermans_1">Lay the two ends side by side, pointing opposite ways. Wrap one end twice round both ropes, then pass it back through the wraps.</string>
    <string name="knot_double_fishermans_2">Do the same with the other end, the other way.</string>
    <string name="knot_double_fishermans_3">Pull the standing parts so the two knots slide together.</string>

    <string name="knot_timber_hitch">Timber hitch</string>
    <string name="knot_timber_hitch_use">Drags or lifts a log or pole. Holds while pulled and falls off when slack.</string>
    <string name="knot_timber_hitch_1">Pass the end round the log.</string>
    <string name="knot_timber_hitch_2">Take it round the standing part.</string>
    <string name="knot_timber_hitch_3">Twist it round its own part three times. Pull the standing part so the turns bite.</string>

