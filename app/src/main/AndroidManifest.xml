<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location, and nothing else: for true north, and for the position the compass and the
         "Calling for help" page show. Only while one of those screens is open. No internet. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The compass works from the rotation sensor; a phone without one still gets the rest. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- The other apps that act on selected text (Define and the rest), for the ⋮ in the
         selection menu; and the map and dialler apps the position is handed to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- The contact picker, and Medicine, for filling in the emergency card. -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
        </intent>
        <package android:name="com.wanderwildwood.fukuyaku" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Other apps open a first-aid page, or "Calling for help" with a position they
                 hold. Opening.kt reads them; the README lists the names. -->
            <intent-filter>
                <action android:name="com.wanderwildwood.zatsuno.action.FIRST_AID" />
                <action android:name="com.wanderwildwood.zatsuno.action.CALL_FOR_HELP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The emergency card for Glance's lock-screen panel: it answers Glance alone, and only
             while "Show on the lock screen" is switched on in the card. -->
        <provider
            android:name=".glance.CardOnLockScreen"
            android:authorities="com.wanderwildwood.zatsuno.glance"
            android:exported="true" />

    </application>

</manifest>
